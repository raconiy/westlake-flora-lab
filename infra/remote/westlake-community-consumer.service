[Unit]
Description=Westlake Flora community assistant queue consumer
Wants=network-online.target
After=network-online.target gpt-load.service westlake-relay.service

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/opt/relay-secrets.env
UnsetEnvironment=GPT_LOAD_ACCESS_KEY
Environment=COMMUNITY_HTTPS_PROXY=http://127.0.0.1:7897
Environment=LOCAL_RELAY_URL=http://127.0.0.1:80
LoadCredential=community-token:/etc/westlake-community/community-relay.key
StateDirectory=westlake-community-consumer
StateDirectoryMode=0700
WorkingDirectory=/opt/westlake-flora-pages
ExecStart=/usr/bin/node /opt/westlake-flora-pages/infra/remote/community-consumer.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=220
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
