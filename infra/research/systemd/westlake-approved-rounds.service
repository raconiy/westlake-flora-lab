[Unit]
Description=Run the next privately approved Westlake reconstruction code round
After=network.target gpt-load.service
ConditionPathIsDirectory=/var/lib/westlake-round-approvals/inbox

[Service]
Type=oneshot
User=westlake-approved
Group=westlake-approved
WorkingDirectory=/usr/local/lib/westlake-approved-rounds
ExecStart=/usr/bin/python3 -E -s -B /usr/local/lib/westlake-approved-rounds/approved_rounds.py /var/lib/westlake-round-approvals/inbox /var/lib/westlake-round-approvals/artifacts /var/lib/westlake-approved-rounds
LoadCredential=inference-key:/etc/westlake-swarm/inference-key
StateDirectory=westlake-approved-rounds
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=infinity
TimeoutStopSec=15s
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/var/lib/westlake-round-approvals
InaccessiblePaths=-/etc/westlake-swarm -/opt/westlake-campus-recon -/etc/westlake-community
SystemCallArchitectures=native
SystemCallFilter=@system-service
Environment=NO_PROXY=127.0.0.1,localhost
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
MemoryMax=384M
TasksMax=32
