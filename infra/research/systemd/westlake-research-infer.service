[Unit]
Description=Westlake data-only inference socket
After=gpt-load.service

[Service]
User=westlake-research-infer
Group=westlake-research-client
RuntimeDirectory=westlake-research-infer
RuntimeDirectoryMode=0750
UMask=0007
LoadCredential=inference-key:/etc/westlake-swarm/inference-key
ExecStart=/usr/bin/node --permission --allow-fs-read=/opt/westlake-swarm/research --allow-fs-read=%d/inference-key --allow-fs-write=/run/westlake-research-infer /opt/westlake-swarm/research/infra/research/inference.mjs
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=240M
TasksMax=32

[Install]
WantedBy=multi-user.target
